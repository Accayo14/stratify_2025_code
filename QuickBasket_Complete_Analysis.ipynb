    "# Comprehensive product analysis\n",
    "print(\"🛍️ COMPREHENSIVE PRODUCT ANALYSIS\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Product performance metrics\n",
    "product_metrics = orders_with_products.groupby('product_name').agg({\n",
    "    'order_id': 'count',  # Frequency\n",
    "    'reordered': ['mean', 'count'],  # Reorder rate and total reorders\n",
    "    'add_to_cart_order': 'mean'  # Average position in cart\n",
    "}).round(3)\n",
    "\n",
    "product_metrics.columns = ['frequency', 'reorder_rate', 'total_reorders', 'avg_cart_position']\n",
    "product_metrics = product_metrics.sort_values('frequency', ascending=False)\n",
    "\n",
    "print(\"\\nTop 20 Products - Comprehensive Metrics:\")\n",
    "print(\"Product Name\".ljust(35) + \"Frequency\".rjust(10) + \"Reorder%\".rjust(10) + \"Avg Cart Pos\".rjust(12))\n",
    "print(\"-\" * 67)\n",
    "\n",
    "for i, (product, row) in enumerate(product_metrics.head(20).iterrows()):\n",
    "    print(f\"{product[:34]:<35}{row['frequency']:>9,}{row['reorder_rate']:>9.1%}{row['avg_cart_position']:>11.1f}\")\n",
