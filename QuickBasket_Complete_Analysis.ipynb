   "source": [
    "## 7. Customer Segmentation <a id=\"segmentation\"></a>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Advanced Customer Segmentation using RFM Analysis\n",
    "print(\"👥 ADVANCED CUSTOMER SEGMENTATION\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Calculate RFM metrics for each customer\n",
    "print(\"Calculating RFM (Recency, Frequency, Monetary) metrics...\")\n",
    "\n",
    "# For Recency, we'll use order_number as a proxy (higher = more recent)\n",
    "customer_rfm = order_metadata.groupby('user_id').agg({\n",
    "    'order_number': 'max',  # Most recent order number (Recency proxy)\n",
    "    'order_id': 'count',    # Total number of orders (Frequency)\n",
    "    'days_since_prior_order': 'mean'  # Average days between orders\n",
    "}).rename(columns={\n",
    "    'order_number': 'recency_score',\n",
    "    'order_id': 'frequency',\n",
    "    'days_since_prior_order': 'avg_days_between_orders'\n",
    "})\n",
    "\n",
    "# Add monetary value proxy (total items purchased)\n",
    "customer_items = order_items.merge(order_metadata[['order_id', 'user_id']], on='order_id')\n",
    "customer_monetary = customer_items.groupby('user_id').agg({\n",
    "    'product_id': 'count',  # Total items purchased\n",
    "    'reordered': 'mean'     # Reorder rate\n",
    "}).rename(columns={\n",
    "    'product_id': 'total_items',\n",
    "    'reordered': 'reorder_rate'\n",
    "})\n",
    "\n",
    "# Merge RFM data\n",
    "customer_rfm = customer_rfm.merge(customer_monetary, left_index=True, right_index=True)\n",
    "customer_rfm['avg_items_per_order'] = customer_rfm['total_items'] / customer_rfm['frequency']\n",
    "customer_rfm['monetary_score'] = customer_rfm['total_items']  # Using total items as monetary proxy\n",
    "\n",
    "print(f\"RFM analysis completed for {len(customer_rfm):,} customers\")\n",
    "\n",
    "# Create quintiles for each RFM component\n",
    "customer_rfm['R_score'] = pd.qcut(customer_rfm['recency_score'], q=5, labels=[1,2,3,4,5])\n",
    "customer_rfm['F_score'] = pd.qcut(customer_rfm['frequency'], q=5, labels=[1,2,3,4,5])\n",
    "customer_rfm['M_score'] = pd.qcut(customer_rfm['monetary_score'], q=5, labels=[1,2,3,4,5])\n",
    "\n",
    "# Create RFM segment\n",
    "customer_rfm['RFM_Score'] = (customer_rfm['R_score'].astype(str) + \n",
    "                            customer_rfm['F_score'].astype(str) + \n",
    "                            customer_rfm['M_score'].astype(str))\n",
    "\n",
    "# Define customer segments based on RFM scores\n",
    "def rfm_segment(row):\n",
    "    r, f, m = int(row['R_score']), int(row['F_score']), int(row['M_score'])\n",
    "    \n",
    "    if r >= 4 and f >= 4 and m >= 4:\n",
    "        return 'Champions'\n",
    "    elif r >= 3 and f >= 4 and m >= 4:\n",
    "        return 'Loyal Customers'\n",
    "    elif r >= 4 and f >= 3 and m >= 3:\n",
    "        return 'Potential Loyalists'\n",
    "    elif r >= 4 and f <= 2 and m <= 2:\n",
    "        return 'New Customers'\n",
    "    elif r >= 3 and f >= 3 and m >= 3:\n",
    "        return 'Promising'\n",
    "    elif r >= 2 and f >= 2 and m >= 2:\n",
    "        return 'Need Attention'\n",
    "    elif r <= 2 and f >= 4:\n",
    "        return 'At Risk'\n",
    "    elif r <= 2 and f <= 2 and m >= 4:\n",
    "        return 'Cannot Lose Them'\n",
    "    elif r <= 2 and f <= 2 and m <= 2:\n",
    "        return 'Hibernating'\n",
    "    else:\n",
    "        return 'Others'\n",
    "\n",
    "customer_rfm['Segment'] = customer_rfm.apply(rfm_segment, axis=1)\n",
    "\n",
    "# Segment analysis\n",
    "segment_analysis = customer_rfm.groupby('Segment').agg({\n",
    "    'frequency': ['count', 'mean'],\n",
    "    'total_items': 'mean',\n",
    "    'avg_items_per_order': 'mean',\n",
    "    'reorder_rate': 'mean',\n",
    "    'recency_score': 'mean'\n",
    "}).round(2)\n",
    "\n",
    "segment_analysis.columns = ['Count', 'Avg_Orders', 'Avg_Items', 'Avg_Items_Per_Order', 'Avg_Reorder_Rate', 'Avg_Recency']\n",
    "segment_analysis['Percentage'] = (segment_analysis['Count'] / segment_analysis['Count'].sum() * 100).round(1)\n",
    "segment_analysis = segment_analysis.sort_values('Count', ascending=False)\n",
    "\n",
    "print(\"\\n🎯 CUSTOMER SEGMENT ANALYSIS:\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"{'Segment':<18} {'Count':<8} {'%':<6} {'Avg Orders':<11} {'Avg Items':<10} {'Items/Order':<12} {'Reorder %':<10}\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for segment, row in segment_analysis.iterrows():\n",
    "    print(f\"{segment:<18} {int(row['Count']):<8} {row['Percentage']:<6.1f} {row['Avg_Orders']:<11.1f} {row['Avg_Items']:<10.0f} {row['Avg_Items_Per_Order']:<12.1f} {row['Avg_Reorder_Rate']:<10.1%}\")\n",
    "\n",
    "print(f\"\\nTotal customers analyzed: {segment_analysis['Count'].sum():,}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# K-Means Clustering for additional insights\n",
    "print(\"\\n\\n🎯 K-MEANS CLUSTERING ANALYSIS\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Prepare features for clustering\n",
    "clustering_features = customer_rfm[['frequency', 'total_items', 'avg_items_per_order', 'reorder_rate']].copy()\n",
    "clustering_features = clustering_features.fillna(clustering_features.mean())\n",
    "\n",
    "# Standardize features\n",
    "scaler = StandardScaler()\n",
    "features_scaled = scaler.fit_transform(clustering_features)\n",
    "\n",
    "# Determine optimal number of clusters using elbow method\n",
    "inertias = []\n",
    "K_range = range(2, 11)\n",
    "\n",
    "for k in K_range:\n",
    "    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
    "    kmeans.fit(features_scaled)\n",
    "    inertias.append(kmeans.inertia_)\n",
    "\n",
    "# Perform K-means with optimal clusters (let's use 5 for interpretability)\n",
    "optimal_k = 5\n",
    "kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)\n",
    "customer_rfm['K_Means_Cluster'] = kmeans.fit_predict(features_scaled)\n",
    "\n",
    "# Analyze K-means clusters\n",
    "cluster_analysis = customer_rfm.groupby('K_Means_Cluster').agg({\n",
    "    'frequency': ['count', 'mean'],\n",
    "    'total_items': 'mean',\n",
    "    'avg_items_per_order': 'mean',\n",
    "    'reorder_rate': 'mean'\n",
    "}).round(2)\n",
    "\n",
    "cluster_analysis.columns = ['Count', 'Avg_Orders', 'Avg_Items', 'Avg_Items_Per_Order', 'Avg_Reorder_Rate']\n",
    "cluster_analysis['Percentage'] = (cluster_analysis['Count'] / cluster_analysis['Count'].sum() * 100).round(1)\n",
    "\n",
    "# Define cluster names based on characteristics\n",
    "cluster_names = {\n",
    "    0: 'Cluster 0',\n",
    "    1: 'Cluster 1', \n",
    "    2: 'Cluster 2',\n",
    "    3: 'Cluster 3',\n",
    "    4: 'Cluster 4'\n",
    "}\n",
    "\n",
    "print(\"\\nK-Means Cluster Analysis:\")\n",
    "print(f\"{'Cluster':<10} {'Count':<8} {'%':<6} {'Avg Orders':<11} {'Avg Items':<10} {'Items/Order':<12} {'Reorder %':<10}\")\n",
    "print(\"-\" * 67)\n",
    "\n",
    "for cluster, row in cluster_analysis.iterrows():\n",
    "    print(f\"{'Cluster ' + str(cluster):<10} {int(row['Count']):<8} {row['Percentage']:<6.1f} {row['Avg_Orders']:<11.1f} {row['Avg_Items']:<10.0f} {row['Avg_Items_Per_Order']:<12.1f} {row['Avg_Reorder_Rate']:<10.1%}\")\n",
    "\n",
    "print(f\"\\nOptimal number of clusters determined: {optimal_k}\")"
   ]
  },
