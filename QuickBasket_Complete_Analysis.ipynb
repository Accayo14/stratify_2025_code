    "## 3. Customer Behavior Analysis <a id=\"customer\"></a>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Customer behavior deep dive\n",
    "print(\"👥 CUSTOMER BEHAVIOR DEEP DIVE\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Customer segments analysis\n",
    "customer_segments = order_metadata['customer_segment'].value_counts()\n",
    "print(\"\\nCustomer Segments Distribution:\")\n",
    "for segment, count in customer_segments.items():\n",
    "    percentage = (count / customer_segments.sum()) * 100\n",
    "    print(f\"   {segment}: {count:,} customers ({percentage:.1f}%)\")\n",
    "\n",
    "# Order frequency analysis\n",
    "orders_per_customer = order_metadata.groupby('user_id')['order_id'].count()\n",
    "print(f\"\\nOrder Frequency Statistics:\")\n",
    "print(f\"   Mean: {orders_per_customer.mean():.1f} orders\")\n",
    "print(f\"   Median: {orders_per_customer.median():.1f} orders\")\n",
    "print(f\"   Std Dev: {orders_per_customer.std():.1f}\")\n",
    "print(f\"   Min: {orders_per_customer.min()} orders\")\n",
    "print(f\"   Max: {orders_per_customer.max()} orders\")\n",
    "\n",
    "# Basket size analysis\n",
    "basket_sizes = order_items.groupby('order_id').size()\n",
    "print(f\"\\nBasket Size Statistics:\")\n",
    "print(f\"   Mean: {basket_sizes.mean():.1f} items\")\n",
    "print(f\"   Median: {basket_sizes.median():.1f} items\")\n",
    "print(f\"   Std Dev: {basket_sizes.std():.1f}\")\n",
    "print(f\"   Min: {basket_sizes.min()} items\")\n",
    "print(f\"   Max: {basket_sizes.max()} items\")\n",
    "\n",
    "# Create customer behavior visualizations\n",
    "fig, axes = plt.subplots(2, 3, figsize=(18, 12))\n",
    "\n",
    "# Customer segments pie chart\n",
    "axes[0, 0].pie(customer_segments.values, labels=customer_segments.index, autopct='%1.1f%%', startangle=90)\n",
    "axes[0, 0].set_title('Customer Segments Distribution', fontweight='bold')\n",
    "\n",
    "# Order frequency distribution\n",
    "axes[0, 1].hist(orders_per_customer, bins=50, color='skyblue', alpha=0.7)\n",
    "axes[0, 1].set_title('Order Frequency Distribution', fontweight='bold')\n",
    "axes[0, 1].set_xlabel('Number of Orders per Customer')\n",
    "axes[0, 1].set_ylabel('Frequency')\n",
    "axes[0, 1].axvline(orders_per_customer.mean(), color='red', linestyle='--', label=f'Mean: {orders_per_customer.mean():.1f}')\n",
    "axes[0, 1].legend()\n",
    "\n",
    "# Basket size distribution\n",
    "axes[0, 2].hist(basket_sizes[basket_sizes <= 50], bins=30, color='lightcoral', alpha=0.7)\n",
    "axes[0, 2].set_title('Basket Size Distribution', fontweight='bold')\n",
    "axes[0, 2].set_xlabel('Items per Order')\n",
    "axes[0, 2].set_ylabel('Frequency')\n",
    "axes[0, 2].axvline(basket_sizes.mean(), color='red', linestyle='--', label=f'Mean: {basket_sizes.mean():.1f}')\n",
    "axes[0, 2].legend()\n",
    "\n",
    "# Days between orders distribution\n",
    "days_between = order_metadata['days_since_prior_order'].dropna()\n",
    "axes[1, 0].hist(days_between[days_between <= 30], bins=30, color='lightgreen', alpha=0.7)\n",
    "axes[1, 0].set_title('Days Between Orders Distribution', fontweight='bold')\n",
    "axes[1, 0].set_xlabel('Days Since Prior Order')\n",
    "axes[1, 0].set_ylabel('Frequency')\n",
    "axes[1, 0].axvline(days_between.mean(), color='red', linestyle='--', label=f'Mean: {days_between.mean():.1f}')\n",
    "axes[1, 0].legend()\n",
    "\n",
    "# Customer loyalty analysis (orders vs basket size)\n",
    "customer_metrics = order_metadata.groupby('user_id').agg({\n",
    "    'order_id': 'count',\n",
    "}).rename(columns={'order_id': 'total_orders'})\n",
    "\n",
    "customer_basket_sizes = order_items.groupby('order_id').size().to_frame('basket_size')\n",
    "customer_basket_sizes = customer_basket_sizes.merge(order_metadata[['order_id', 'user_id']], on='order_id')\n",
    "avg_basket_by_customer = customer_basket_sizes.groupby('user_id')['basket_size'].mean()\n",
    "customer_metrics['avg_basket_size'] = avg_basket_by_customer\n",
    "\n",
    "# Sample for visualization (too many points otherwise)\n",
    "sample_customers = customer_metrics.sample(n=min(1000, len(customer_metrics)))\n",
    "axes[1, 1].scatter(sample_customers['total_orders'], sample_customers['avg_basket_size'], alpha=0.6, color='purple')\n",
    "axes[1, 1].set_title('Customer Loyalty vs Basket Size', fontweight='bold')\n",
    "axes[1, 1].set_xlabel('Total Orders per Customer')\n",
    "axes[1, 1].set_ylabel('Average Basket Size')\n",
    "\n",
    "# Reorder rate by customer segment\n",
    "segment_reorder = orders_with_products.groupby('customer_segment')['reordered'].mean().sort_values(ascending=True)\n",
    "segment_reorder.plot(kind='barh', ax=axes[1, 2], color='gold')\n",
    "axes[1, 2].set_title('Reorder Rate by Customer Segment', fontweight='bold')\n",
    "axes[1, 2].set_xlabel('Reorder Rate')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
