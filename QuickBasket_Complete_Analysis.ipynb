    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "import plotly.figure_factory as ff\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Advanced analytics libraries\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import mean_squared_error, r2_score\n",
    "\n",
    "# Market basket analysis\n",
    "from mlxtend.frequent_patterns import apriori, association_rules\n",
    "from mlxtend.preprocessing import TransactionEncoder\n",
    "\n",
    "# Network analysis\n",
    "import networkx as nx\n",
    "from collections import Counter\n",
    "import itertools\n",
    "\n",
    "# Set styling\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "sns.set_palette(\"husl\")\n",
    "plt.rcParams['figure.figsize'] = (15, 8)\n",
    "plt.rcParams['font.size'] = 12\n",
    "\n",
    "print(\"✅ All libraries imported successfully!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load all datasets with comprehensive error handling\n",
    "print(\"📊 Loading QuickBasket datasets...\")\n",
    "\n",
    "try:\n",
    "    # Load reference data\n",
    "    aisles = pd.read_csv('aisle_info.csv')\n",
    "    departments = pd.read_csv('department_info.csv')\n",
    "    products = pd.read_csv('product_catalog.csv')\n",
    "    \n",
    "    # Load order metadata (combining multiple files)\n",
    "    metadata_files = [\n",
    "        'order_metadata.csv',\n",
    "        'order_metadata_3371.csv', 'order_metadata_3372.csv', 'order_metadata_3373.csv',\n",
    "        'order_metadata_3374.csv', 'order_metadata_3375.csv', 'order_metadata_3376.csv',\n",
    "        'order_metadata_3377.csv'\n",
    "    ]\n",
    "    \n",
    "    order_metadata_list = []\n",
    "    for file in metadata_files:\n",
    "        try:\n",
    "            df = pd.read_csv(file)\n",
    "            order_metadata_list.append(df)\n",
    "            print(f\"   ✓ Loaded {file}: {df.shape}\")\n",
    "        except FileNotFoundError:\n",
    "            print(f\"   ⚠️ File not found: {file}\")\n",
    "    \n",
    "    order_metadata = pd.concat(order_metadata_list, ignore_index=True)\n",
    "    \n",
    "    # Load order items (combining train and prior data)\n",
    "    items_files = [\n",
    "        'order_items__train.csv', 'order_items__prior.csv',\n",
    "        'order_items__train_1248.csv', 'order_items__train_1249.csv',\n",
    "        'order_items__train_1250.csv', 'order_items__train_1251.csv',\n",
    "        'order_items__train_1252.csv',\n",
    "        'order_items__prior_10000.csv', 'order_items__prior_10001.csv',\n",
    "        'order_items__prior_1000.csv', 'order_items__prior_10.csv',\n",
    "        'order_items__prior_100.csv', 'order_items__prior_1.csv'\n",
    "    ]\n",
    "    \n",
    "    order_items_list = []\n",
    "    for file in items_files:\n",
    "        try:\n",
    "            df = pd.read_csv(file)\n",
    "            order_items_list.append(df)\n",
    "            print(f\"   ✓ Loaded {file}: {df.shape}\")\n",
    "        except FileNotFoundError:\n",
    "            print(f\"   ⚠️ File not found: {file}\")\n",
    "    \n",
    "    order_items = pd.concat(order_items_list, ignore_index=True)\n",
    "    \n",
    "    print(f\"\\n📈 Dataset Summary:\")\n",
    "    print(f\"   Order metadata: {order_metadata.shape}\")\n",
    "    print(f\"   Order items: {order_items.shape}\")\n",
    "    print(f\"   Products: {products.shape}\")\n",
    "    print(f\"   Aisles: {aisles.shape}\")\n",
    "    print(f\"   Departments: {departments.shape}\")\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"❌ Error loading data: {e}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data preprocessing and enrichment\n",
    "print(\"🔧 Data Preprocessing and Enrichment...\")\n",
    "\n",
    "# Create day of week mapping\n",
    "dow_mapping = {0: 'Sunday', 1: 'Monday', 2: 'Tuesday', 3: 'Wednesday', \n",
    "               4: 'Thursday', 5: 'Friday', 6: 'Saturday'}\n",
    "order_metadata['day_name'] = order_metadata['order_dow'].map(dow_mapping)\n",
    "\n",
    "# Create time of day categories\n",
    "def get_time_period(hour):\n",
    "    if hour < 6:\n",
    "        return 'Early Morning (0-5)'\n",
    "    elif hour < 12:\n",
    "        return 'Morning (6-11)'\n",
    "    elif hour < 17:\n",
    "        return 'Afternoon (12-16)'\n",
    "    elif hour < 21:\n",
    "        return 'Evening (17-20)'\n",
    "    else:\n",
    "        return 'Night (21-23)'\n",
    "\n",
    "order_metadata['time_period'] = order_metadata['order_hour_of_day'].apply(get_time_period)\n",
    "\n",
    "# Create customer segments based on order frequency\n",
    "user_order_counts = order_metadata.groupby('user_id')['order_id'].count()\n",
    "def categorize_customer(count):\n",
    "    if count <= 5:\n",
    "        return 'Low Frequency (1-5 orders)'\n",
    "    elif count <= 15:\n",
    "        return 'Medium Frequency (6-15 orders)'\n",
    "    elif count <= 30:\n",
    "        return 'High Frequency (16-30 orders)'\n",
    "    else:\n",
    "        return 'Very High Frequency (30+ orders)'\n",
    "\n",
    "user_segments = user_order_counts.apply(categorize_customer)\n",
    "order_metadata = order_metadata.merge(user_segments.to_frame('customer_segment'), left_on='user_id', right_index=True)\n",
    "\n",
    "# Merge datasets for comprehensive analysis\n",
    "orders_with_products = order_items.merge(products, on='product_id', how='left')\n",
    "orders_with_products = orders_with_products.merge(aisles, on='aisle_id', how='left')\n",
    "orders_with_products = orders_with_products.merge(departments, on='department_id', how='left')\n",
    "orders_with_products = orders_with_products.merge(order_metadata[['order_id', 'user_id', 'order_dow', 'order_hour_of_day', 'day_name', 'time_period', 'customer_segment']], on='order_id', how='left')\n",
    "\n",
    "print(f\"✅ Preprocessing complete!\")\n",
    "print(f\"   Enhanced order metadata: {order_metadata.shape}\")\n",
    "print(f\"   Comprehensive order dataset: {orders_with_products.shape}\")"
   ]
  },
